---
import { site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  refresh?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  noindex = false,
  refresh,
  bodyClass
} = Astro.props;

const canonical = new URL(path, site.url).toString();
const ogImage = new URL("/assets/og.png", site.url).toString();
const goatcounter = "https://po-man.goatcounter.com/count";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  {refresh && <meta http-equiv="refresh" content={refresh}>}
  <meta name="theme-color" content="#f3f0e7">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/newsreader-400-600-latin.woff2" as="font" type="font/woff2" crossorigin>
  <slot name="head" />

  <meta property="og:type" content="website">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <slot name="head" />
  <script is:inline define:vars={{ goatcounter }}>
    (function () {
      var url = new URL(window.location.href);
      var keys = ["ref", "src", "source", "campaign", "utm_source", "utm_campaign", "utm_medium", "utm_term", "utm_content"];
      var dirty = false;
      keys.forEach(function (key) {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key);
          dirty = true;
        }
      });
      if (!dirty) return;

      var clean = url.pathname + (url.search || "") + url.hash;
      var done = false;
      var strip = function () {
        if (done) return;
        done = true;
        window.history.replaceState(window.history.state, "", clean);
      };

      // Strip only after GoatCounter has captured location.search, so the
      // campaign survives while the address bar stays clean.
      if (window.navigator && window.navigator.sendBeacon) {
        var beacon = window.navigator.sendBeacon.bind(window.navigator);
        window.navigator.sendBeacon = function (target, data) {
          var ok = beacon(target, data);
          if (typeof target === "string" && target.indexOf(goatcounter) === 0) strip();
          return ok;
        };
      }

      // Fallback for browsers without sendBeacon; only strip once visible.
      var fallback = function () {
        if (document.visibilityState === "visible") strip();
        else
          document.addEventListener(
            "visibilitychange",
            function () {
              if (document.visibilityState === "visible") strip();
            },
            { once: true }
          );
      };
      window.addEventListener("load", fallback);
    })();
  </script>
  <script data-goatcounter={goatcounter} async src="//gc.zgo.at/count.js"></script>
</head>
<body class={bodyClass}>
  <slot />
  <script>
    import "../scripts/analytics.js";
  </script>
</body>
</html>